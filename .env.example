# ─── Required ─────────────────────────────────────────────────────────────────
REPLICATE_API_TOKEN=r8_your_token_here
ELEVENLABS_API_KEY=your_eleven_key_here

# ─── Optional overrides ────────────────────────────────────────────────────────
# ElevenLabs voice ID (default: Rachel — warm, kid-friendly)
# Browse voices at: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Your Railway public URL (set automatically by Railway after first deploy)
RAILWAY_PUBLIC_URL=https://your-service.up.railway.app

# Frontend URL for CORS (your React app domain)
FRONTEND_URL=https://your-frontend.up.railway.app

# Port (Railway sets this automatically)
PORT=3000
